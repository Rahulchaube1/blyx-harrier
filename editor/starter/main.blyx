use vendor::harrier::harrier;

fn main() {
    let now = 100.0;
    let begins = 90.0;
    let expires = 110.0;
    let skew = 0.0;
    let observed = 2.0;
    let required = 2.0;
    let auth_time = 92.0;
    let max_age = 10.0;
    let result = harrier_session(now, begins, expires, skew, observed, required, auth_time, max_age);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
