use std::cli;
use harrier;

fn matches(actual: vector, expected: vector) -> bool {
    if len(actual) != len(expected) { return false; }
    let mut i = 0;
    while i < len(expected) {
        let delta = at(actual, i) - at(expected, i);
        let limit = 0.000000001 + 0.000000001 * at(expected, i) * at(expected, i) / (1.0 + at(expected, i) * at(expected, i));
        if !(delta >= -limit && delta <= limit) { return false; }
        i += 1;
    }
    true
}

fn main() {
    let infinity = 1.0e300 * 1.0e300;
    if !matches(harrier_session(100.0, 90.0, 110.0, 0.0, 2.0, 2.0, 92.0, 10.0), [1, 1, 1, 8]) { stderr_line("case 1 failed"); process_exit(1); }
    if !matches(harrier_session(110.0, 90.0, 110.0, 0.0, 2.0, 2.0, 105.0, 10.0), [0, 0, 1, 5]) { stderr_line("case 2 failed"); process_exit(1); }
    if !matches(harrier_session(100.0, 90.0, 110.0, 0.0, 1.0, 2.0, 90.0, 20.0), [0, 1, 0, 10]) { stderr_line("case 3 failed"); process_exit(1); }
    if !matches(harrier_session(100.0, 90.0, 110.0, 0.0, 2.0, 2.0, 105.0, 10.0), []) { stderr_line("case 4 failed"); process_exit(1); }
    if !matches(harrier_session(infinity, 90.0, 110.0, 0.0, 2.0, 2.0, 92.0, 10.0), []) { stderr_line("case 5 failed"); process_exit(1); }
    if !matches(harrier_session(100.0, infinity, 110.0, 0.0, 2.0, 2.0, 92.0, 10.0), []) { stderr_line("case 6 failed"); process_exit(1); }
    if !matches(harrier_session(100.0, 90.0, infinity, 0.0, 2.0, 2.0, 92.0, 10.0), []) { stderr_line("case 7 failed"); process_exit(1); }
    if !matches(harrier_session(100.0, 90.0, 110.0, infinity, 2.0, 2.0, 92.0, 10.0), []) { stderr_line("case 8 failed"); process_exit(1); }
    if !matches(harrier_session(100.0, 90.0, 110.0, 0.0, infinity, 2.0, 92.0, 10.0), []) { stderr_line("case 9 failed"); process_exit(1); }
    if !matches(harrier_session(100.0, 90.0, 110.0, 0.0, 2.0, infinity, 92.0, 10.0), []) { stderr_line("case 10 failed"); process_exit(1); }
    if !matches(harrier_session(100.0, 90.0, 110.0, 0.0, 2.0, 2.0, infinity, 10.0), []) { stderr_line("case 11 failed"); process_exit(1); }
    if !matches(harrier_session(100.0, 90.0, 110.0, 0.0, 2.0, 2.0, 92.0, infinity), []) { stderr_line("case 12 failed"); process_exit(1); }
    println!("passed");
}
