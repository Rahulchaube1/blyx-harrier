use std::cli;
use console;
use harrier;

fn main() {
    let argv = cli_args();
    let count = args_len(argv);
    if count == 1 && args_at(argv, 0) == "--help" {
        println!("Apply time and assurance policy to a session after upstream identity verification.");
        println!("Usage: harrier now begins expires skew observed required auth_time max_age");
        println!("Vector arguments are comma-separated; use [] for an empty vector.");
        return;
    }
    let mut result = [];
    if count == 0 {
        result = harrier_session(100.0, 90.0, 110.0, 0.0, 2.0, 2.0, 92.0, 10.0);
    } else {
        if count != 8 { stderr_line("Wrong argument count. Use --help."); process_exit(2); }
        let now = console_value(args_at(argv, 0));
        let begins = console_value(args_at(argv, 1));
        let expires = console_value(args_at(argv, 2));
        let skew = console_value(args_at(argv, 3));
        let observed = console_value(args_at(argv, 4));
        let required = console_value(args_at(argv, 5));
        let auth_time = console_value(args_at(argv, 6));
        let max_age = console_value(args_at(argv, 7));
        result = harrier_session(now, begins, expires, skew, observed, required, auth_time, max_age);
    }
    if len(result) == 0 { stderr_line("Invalid input for Harrier. See the package input contract."); process_exit(1); }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
